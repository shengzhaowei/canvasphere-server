# Canvasphere 环境变量示例
# 使用方法：把本文件复制为 .env 后再填真实值，.env 不要提交到 Git 仓库。
# 本文件里全部是占位值，没有任何真实密钥。

# LLM 服务地址（OpenAI 兼容接口的 base URL，占位值，填你实际用的中转或官方地址）
LLM_BASE_URL=https://api.example.com/v1
# LLM API Key（占位值，复制为 .env 后替换为真实 Key，绝不要把真实 Key 写进本文件或提交）
LLM_API_KEY=sk-your-key-here
# LLM 模型名（占位值，填你实际要用的便宜模型，如国内兼容模型或中转支持的模型）
LLM_MODEL=your-cheap-model
# 模型单价（占位价，单位：积分/百万 Token；默认输入 30、输出 150）
# 后端 /api/config 和费用估算读这两个值；请按你所用中转的实际价改，留空则用默认值
LLM_PRICE_INPUT=30
LLM_PRICE_OUTPUT=150
# E2B 沙盒 API Key（2026-11-26 已弃用：E2B 要求绑美国银行卡，改走本地 Docker 沙盒，
# 留空即可；即使填了，没有 e2b-code-interpreter 依赖也会回退提示不可用）
E2B_API_KEY=
# Postgres 连接串（占位值：用户名/密码/库名均为 canvas，与 docker-compose.yml 的 db 服务一致）
POSTGRES_USER=canvas
POSTGRES_PASSWORD=canvas
POSTGRES_DB=canvas
DATABASE_URL=postgresql://canvas:canvas@db:5432/canvas
# Yjs 协同服务地址（本地开发时指向本机 1234 端口的 y-websocket 服务）
YJS_URL=ws://localhost:1234
# 前端调用后端的 API 地址（本地开发时指向本机 8000 端口的 FastAPI 服务）
VITE_API_URL=http://localhost:8000
# CORS 允许的前端源（逗号分隔；线上 IP 8.220.194.80:5173 已在代码默认值里）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5175,http://127.0.0.1:5175,http://8.220.194.80:5173,http://8.220.194.80:5175

# --- P0 运行时与认证 ---
SYSTEM_TIMEZONE=Asia/Shanghai
APP_BASE_URL=http://localhost:8000
# OAuth 登录成功后前端回调页地址（后端把 token 以 URL fragment 形式 302 到这里；生产填 Vercel 域名）
FRONTEND_URL=https://canvasphere-three.vercel.app
# 生产环境务必替换为 32+ 字节高熵随机字符串
JWT_SECRET=replace-with-strong-random-secret
ACCESS_TOKEN_TTL_SECONDS=7200
REFRESH_TOKEN_TTL_DAYS=30
# 生产环境保持 false；仅兼容未接入登录的旧前端/本地调试时可临时设为 true
AUTH_ALLOW_LEGACY_ROLE_HEADER=false

# --- OAuth 三方登录（按需填写）---
OAUTH_REDIRECT_BASE_URL=http://localhost:8000
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_LINUXDO_CLIENT_ID=
OAUTH_LINUXDO_CLIENT_SECRET=

# --- 邮件验证码 SMTP（留空时仅记录发送日志，不外发真实邮件）---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- 对象存储（auto：配置 S3_* 时走 S3/OSS/R2/MinIO，否则降级本地签名直传）---
STORAGE_BACKEND=auto
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_PUBLIC_BASE_URL=
LOCAL_STORAGE_DIR=/data/storage
USER_STORAGE_QUOTA_BYTES=1073741824

# --- P1 实时协同、积分钱包与多模态聚合网关 ---
OBJECT_LEASE_TTL_SECONDS=60
PRESENCE_TTL_SECONDS=30
DEFAULT_SIGNUP_BONUS_CREDITS=300
VOICE_FIRST_USE_CREDITS=1000
# 可选：统一多模态中转网关地址与 Key（留空时走安全 Mock 降级全链路）
MODEL_GATEWAY_BASE_URL=
MODEL_GATEWAY_API_KEY=

# --- P2/P3 上下文压缩、沙盒、MCP 与 BYOK 加密 ---
CONTEXT_COMPRESS_THRESHOLD_TOKENS=4000
SANDBOX_DEFAULT_CAP_CREDITS=500
SANDBOX_DEFAULT_IDLE_MINUTES=2
# 可选：独立 Fernet 32 字节 Base64 密钥（留空时从 JWT_SECRET 派生）
BYOK_ENCRYPTION_KEY=

# --- P4 4C8G 轻量生产加固（Redis / ARQ Worker / 限流 / 并发护栏）---
REDIS_URL=redis://redis:6379/0
ASYNC_WORKER_ENABLED=true
UVICORN_WORKERS=2
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
SANDBOX_MAX_CONCURRENT=2
SANDBOX_DOCKER_MEMORY=512m
SANDBOX_DOCKER_CPUS=0.5
FFMPEG_THREADS=2
FFMPEG_MAX_CONCURRENT=1
RATE_LIMIT_LOGIN_PER_MIN=20
RATE_LIMIT_EMAIL_CODE_PER_MIN=5
ORPHAN_UPLOAD_MAX_AGE_HOURS=24

# --- P5 MCP HTTP 强鉴权、Webhook 与 6 大厂商直连配置（均可选，留空走 Mock）---
MCP_REQUIRE_OAUTH_TOKEN=true
PROVIDER_WEBHOOK_SECRET=replace-with-webhook-secret
OPENAI_IMAGE_BASE_URL=https://api.openai.com
OPENAI_IMAGE_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com
ARK_API_KEY=
MJ_BASE_URL=
MJ_API_KEY=
SEEDANCE_BASE_URL=
SEEDANCE_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.chat
MINIMAX_API_KEY=
SUNO_BASE_URL=
SUNO_API_KEY=

# --- P6/P7 可观测性、Yjs JWT 房间鉴权与严格启动检查 ---
LOG_FORMAT=json
YJS_REQUIRE_AUTH=true
# 线上完成密钥替换后可设为 true，启动时强制拒绝默认弱密钥
PRODUCTION_STRICT=false
