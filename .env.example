# Canvasphere 环境变量示例
# 使用方法：把本文件复制为 .env 后再填真实值，.env 不要提交到 Git 仓库。
# 本文件里全部是占位值，没有任何真实密钥。

# LLM 服务地址（OpenAI 兼容接口的 base URL，占位值，填你实际用的中转或官方地址）
LLM_BASE_URL=https://api.example.com/v1
# LLM API Key（占位值，复制为 .env 后替换为真实 Key，绝不要把真实 Key 写进本文件或提交）
LLM_API_KEY=sk-your-key-here
# LLM 模型名（占位值，填你实际要用的便宜模型，如国内兼容模型或中转支持的模型）
LLM_MODEL=your-cheap-model
# 模型单价（占位价，单位：积分/百万 Token；默认输入 30、输出 150）
# 后端 /api/config 和费用估算读这两个值；请按你所用中转的实际价改，留空则用默认值
LLM_PRICE_INPUT=30
LLM_PRICE_OUTPUT=150
# E2B 沙盒 API Key（2026-11-26 已弃用：E2B 要求绑美国银行卡，改走本地 Docker 沙盒，
# 留空即可；即使填了，没有 e2b-code-interpreter 依赖也会回退提示不可用）
E2B_API_KEY=
# Postgres 连接串（占位值：用户名/密码/库名均为 canvas，与 docker-compose.yml 的 db 服务一致）
DATABASE_URL=postgresql://canvas:canvas@db:5432/canvas
# Yjs 协同服务地址（本地开发时指向本机 1234 端口的 y-websocket 服务）
YJS_URL=ws://localhost:1234
# 前端调用后端的 API 地址（本地开发时指向本机 8000 端口的 FastAPI 服务）
VITE_API_URL=http://localhost:8000
# CORS 允许的前端源（逗号分隔；线上 IP 8.220.194.80:5173 已在代码默认值里）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://8.220.194.80:5173
